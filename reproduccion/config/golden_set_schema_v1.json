{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andgosds/tfm-dsbd/blob/main/config/golden_set_schema_v1.json",
  "title": "Golden set v1 para recuperación educativa",
  "description": "Contrato de cada pregunta en inglés contra corpus_v1 y section_paragraphs_300w_overlap60_v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_version",
    "chunking_method",
    "qid",
    "question",
    "question_language",
    "question_type",
    "answerability",
    "unanswerable_category",
    "gold_answer",
    "answer_language",
    "evidence_sufficient",
    "evidence",
    "notes",
    "question_origin",
    "annotator_id",
    "reviews",
    "human_adjudication",
    "annotation_status"
  ],
  "properties": {
    "schema_version": {"const": "golden_set_v1"},
    "corpus_version": {"const": "corpus_v1"},
    "chunking_method": {"const": "section_paragraphs_300w_overlap60_v1"},
    "qid": {"type": "string", "pattern": "^q-v1-[0-9]{3}$"},
    "question": {"type": "string", "minLength": 1},
    "question_language": {"const": "en"},
    "question_type": {"enum": ["factual", "explanatory", "comparative", "procedural"]},
    "answerability": {"enum": ["answerable", "unanswerable"]},
    "unanswerable_category": {
      "enum": [
        "out_of_scope",
        "nonexistent_entity_or_concept",
        "false_premise",
        "missing_evidence",
        "insufficient_evidence",
        null
      ]
    },
    "gold_answer": {"type": ["string", "null"]},
    "answer_language": {"enum": ["en", null]},
    "evidence_sufficient": {"type": "boolean"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "notes": {"type": "string"},
    "question_origin": {"enum": ["human", "llm_assisted"]},
    "annotator_id": {"type": "string", "minLength": 1},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "human_adjudication": {
      "anyOf": [
        {"$ref": "#/$defs/human_adjudication"},
        {"type": "null"}
      ]
    },
    "annotation_status": {"enum": ["draft", "reviewed", "adjudicated"]}
  },
  "allOf": [
    {
      "if": {"properties": {"answerability": {"const": "answerable"}}},
      "then": {
        "properties": {
          "unanswerable_category": {"type": "null"},
          "gold_answer": {"type": "string", "minLength": 1},
          "answer_language": {"const": "en"},
          "evidence_sufficient": {"const": true},
          "evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"answerability": {"const": "unanswerable"}}},
      "then": {
        "properties": {
          "unanswerable_category": {
            "enum": [
              "out_of_scope",
              "nonexistent_entity_or_concept",
              "false_premise",
              "missing_evidence",
              "insufficient_evidence"
            ]
          },
          "gold_answer": {"type": "null"},
          "answer_language": {"type": "null"},
          "evidence_sufficient": {"const": false},
          "notes": {"minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"annotation_status": {"const": "reviewed"}}},
      "then": {
        "properties": {
          "reviews": {"minItems": 1},
          "human_adjudication": {"$ref": "#/$defs/human_adjudication"}
        }
      }
    },
    {
      "if": {"properties": {"annotation_status": {"const": "adjudicated"}}},
      "then": {
        "properties": {
          "reviews": {"minItems": 2},
          "human_adjudication": {"$ref": "#/$defs/human_adjudication"}
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "relevance_grade",
        "is_canonical",
        "quote",
        "supports",
        "source_verified",
        "verification_note"
      ],
      "properties": {
        "chunk_id": {"type": "string", "minLength": 1},
        "relevance_grade": {"enum": [1, 2]},
        "is_canonical": {"type": "boolean"},
        "quote": {"type": "string", "minLength": 1},
        "supports": {"type": "string", "minLength": 1},
        "source_verified": {"type": "boolean"},
        "verification_note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"is_canonical": {"const": true}}},
          "then": {"properties": {"relevance_grade": {"const": 2}}}
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_type",
        "reviewer_id",
        "model_version",
        "prompt_version",
        "answerability_decision",
        "evidence_sufficient_decision",
        "reference_answer_decision",
        "rationale",
        "confidence",
        "execution_date"
      ],
      "properties": {
        "reviewer_type": {"const": "llm"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "answerability_decision": {"enum": ["answerable", "unanswerable"]},
        "evidence_sufficient_decision": {"type": "boolean"},
        "reference_answer_decision": {"enum": ["accept", "revise", "not_applicable"]},
        "rationale": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "execution_date": {"type": "string", "format": "date"}
      }
    },
    "human_adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "final_answerability",
        "final_evidence_sufficient",
        "decision",
        "rationale"
      ],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "final_answerability": {"enum": ["answerable", "unanswerable"]},
        "final_evidence_sufficient": {"type": "boolean"},
        "decision": {"enum": ["accept", "revise", "exclude"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
